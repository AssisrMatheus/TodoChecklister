<Ui xmlns="http://www.blizzard.com/wow/ui/"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
  <Script file="objectiveTracker.lua"/>

  <!-- The list's section under the objective tracker (retail and Forever). Our own frames, which Blizzard's tracker
       code never calls, styled like a tracker section. Nothing here inherits a tracker template: the Classic clients
       don't have them. ObjectiveTrackerSection:Init adds Blizzard's section header (ObjectiveTrackerModuleHeaderTemplate)
       and the tracker fonts from Lua -->
  <Frame name="TodoChecklisterTrackerSectionTemplate" parent="UIParent" frameStrata="LOW" hidden="true" virtual="true">
    <Size x="260" y="26"/>
    <Frames>
      <!-- Holds the rows. ObjectiveTrackerSection:Layout anchors it below whichever header the style uses -->
      <Frame parentKey="Contents">
        <Anchors>
          <Anchor point="TOPLEFT" y="-36"/>
          <Anchor point="BOTTOMRIGHT"/>
        </Anchors>
      </Frame>

      <!-- The list name styled like a Questie zone line, used in place of Blizzard's header next to Questie's tracker.
           Layout sets its font, color, size and anchors from Questie's settings -->
      <Button parentKey="QuestieHeader" hidden="true">
        <Layers>
          <Layer level="ARTWORK">
            <FontString parentKey="Text" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
              <Anchors>
                <Anchor point="TOPLEFT"/>
                <Anchor point="RIGHT"/>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
      </Button>
    </Frames>
  </Frame>

  <!-- One row: a folder name (styled like a quest title) or an item (styled like an objective, with the window's
       checkbox, a bit smaller, in the 10px a dash would use). No hyperlinks, like the window's rows, so links don't
       swallow clicks and drags. Scripts are set from Lua: they need the module's closures -->
  <Button name="TodoChecklisterTrackerLineTemplate" virtual="true">
    <Layers>
      <Layer level="ARTWORK">
        <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
          <Anchors>
            <Anchor point="TOPLEFT" x="10"/>
            <Anchor point="RIGHT"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <CheckButton parentKey="TodoCheckButton" inherits="UICheckButtonTemplate">
        <Size x="16" y="16"/>
        <Anchors>
          <Anchor point="TOPRIGHT" relativeKey="$parent.Text" relativePoint="TOPLEFT" x="-3" y="2"/>
        </Anchors>
      </CheckButton>
    </Frames>
  </Button>
</Ui>
