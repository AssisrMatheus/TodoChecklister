<Ui xmlns="http://www.blizzard.com/wow/ui/"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
  <Script file="TodoChecklister.lua"/>

  <!-- Line shown where a dragged item will be dropped -->
  <Frame name="DropIndicatorTemplate" virtual="true">
    <Size y="3"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Texture" setAllPoints="true" file="Interface\QuestFrame\UI-QuestLogTitleHighlight" alphaMode="ADD"/>
      </Layer>
    </Layers>

    <Scripts>
      <OnLoad>
        self.Texture:SetVertexColor(NORMAL_FONT_COLOR.r, NORMAL_FONT_COLOR.g, NORMAL_FONT_COLOR.b);
      </OnLoad>
    </Scripts>
  </Frame>

  <!-- One row of the list. Left-clicking the row selects it to edit (or rename) it, right-clicking turns it into a folder
       (or back), the +/- of a folder opens or closes it, dragging it reorders the list.
       BackdropTemplate without backdropInfo: only the clone that follows the cursor while dragging gets a backdrop -->
  <Button name="TodoItemTemplate" inherits="BackdropTemplate" virtual="true">
    <Size x="200" y="30"/>
    <Frames>
      <!-- Checkbox, attached to the left side of the row -->
      <CheckButton parentKey="TodoCheckButton" inherits="UICheckButtonTemplate">
        <Size x="24" y="24"/>
        <Anchors>
          <Anchor point="LEFT"/>
        </Anchors>
        <Scripts>
          <OnClick>
            OnCheckItem(self)
            PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
          </OnClick>
        </Scripts>
      </CheckButton>

      <!-- Folders show +/- in place of the checkbox, which is hidden on them. Clicking it opens or closes the folder.
           Its textures depend on the folder state, so PaintItem sets them -->
      <Button parentKey="FolderButton" hidden="true">
        <Size x="14" y="14"/>
        <Anchors>
          <Anchor point="CENTER" relativeKey="$parent.TodoCheckButton"/>
        </Anchors>
        <HighlightTexture file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD"/>
        <Scripts>
          <OnClick>
            PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
            TodoChecklister_OnFolderButtonClick(self)
          </OnClick>
        </Scripts>
      </Button>

      <!-- Remove button, attached to the right side of the row -->
      <Button parentKey="RemoveButton">
        <Size x="20" y="20"/>
        <Anchors>
          <Anchor point="RIGHT" x="-4" y="0"/>
        </Anchors>
        <NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
        <PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
        <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
        <Scripts>
          <OnClick>
            PlaySound(SOUNDKIT.IG_CHARACTER_INFO_CLOSE);
            OnRemoveItem(self)
          </OnClick>
        </Scripts>
      </Button>
    </Frames>

    <!-- Item text, between the checkbox and the remove button. Shifts down while pressed -->
    <ButtonText parentKey="Text" justifyH="LEFT" wordwrap="false">
      <Anchors>
        <Anchor point="LEFT" relativeKey="$parent.TodoCheckButton" relativePoint="RIGHT"/>
        <Anchor point="RIGHT" relativeKey="$parent.RemoveButton" relativePoint="LEFT"/>
      </Anchors>
    </ButtonText>
    <NormalFont style="GameFontNormalSmall"/>
    <PushedTextOffset x="2" y="-2"/>

    <Layers>
      <Layer level="OVERLAY" textureSubLevel="7">
        <!-- Strikes through checked items, across the text area between the checkbox and the remove button -->
        <Texture parentKey="Strikethrough" hidden="true">
          <Size y="1"/>
          <Anchors>
            <Anchor point="LEFT" relativeKey="$parent.TodoCheckButton" relativePoint="RIGHT"/>
            <Anchor point="RIGHT" relativeKey="$parent.RemoveButton" relativePoint="LEFT"/>
          </Anchors>
          <Color color="NORMAL_FONT_COLOR"/>
        </Texture>
      </Layer>
    </Layers>

    <!-- Shown on hover, and kept on (LockHighlight) for the selected row and the drag clone -->
    <HighlightTexture file="Interface\QuestFrame\UI-QuestLogTitleHighlight" alphaMode="ADD">
      <Size y="16"/>
      <Anchors>
        <Anchor point="LEFT" relativeKey="$parent.TodoCheckButton" relativePoint="RIGHT"/>
        <Anchor point="RIGHT" relativeKey="$parent.RemoveButton" relativePoint="LEFT" x="-6"/>
      </Anchors>
    </HighlightTexture>

    <Scripts>
      <!-- prepend: BackdropTemplate has its own OnLoad -->
      <OnLoad inherit="prepend">
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp");
      </OnLoad>
      <OnClick>
        OnSelectItem(self, button)
        PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
      </OnClick>
    </Scripts>
  </Button>

  <Frame name="TodoChecklisterTemplate" inherits="TodoChecklisterResponsiveFrameTemplate" parent="UIParent" virtual="true">
    <Scripts>
      <OnShow>
        OnShow(self)
      </OnShow>
    </Scripts>

    <Anchors>
      <Anchor point="BOTTOMRIGHT">
        <Offset x="-120" y="30"/>
      </Anchor>
    </Anchors>

    <Frames>
      <GameTooltip parentKey="TodoTooltip" name="$parentTodoTooltip" frameStrata="TOOLTIP" inherits="GameTooltipTemplate" />

      <CheckButton parentKey="KeepFocus" name="$parentKeepFocus" inherits="UICheckButtonTemplate" hidden="true">
        <Size x="20" y="20"/>

        <Scripts>
          <OnClick>
            ToggleFocusSettings(self)
            PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
          </OnClick>
          <OnLoad>
            self.Focus:SetText("Quick add");
          </OnLoad>
          <OnEnter>
            self:GetParent().TodoTooltip:SetOwner(self, "ANCHOR_NONE")
            self:GetParent().TodoTooltip:ClearAllPoints()
            self:GetParent().TodoTooltip:SetPoint("BOTTOMRIGHT", self, "TOPRIGHT")
            self:GetParent().TodoTooltip:AddLine("Keep the text box active after adding an item,\r\nso you can type the next one right away",1,1,1)
            self:GetParent().TodoTooltip:Show()
          </OnEnter>
          <OnLeave>
            self:GetParent().TodoTooltip:Hide()
          </OnLeave>
        </Scripts>

        <Anchors>
          <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT">
            <Offset x="-30" y="-6"/>
          </Anchor>
        </Anchors>

        <Layers>
          <Layer level="OVERLAY">
            <FontString name="$parentFocus" parentKey="Focus" inherits="GameFontHighlightSmallOutline" justifyH="RIGHT">
              <Anchors>
                <Anchor point="RIGHT" relativeTo="$parent" relativePoint="LEFT">
                </Anchor>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
      </CheckButton>

      <EditBox parentKey="TodoText" name="$parentTodoText" autoFocus="false" inherits="InputBoxTemplate">
        <Size x="0" y="20"/>
        <Scripts>
          <OnEnterPressed>
            OnSaveItem(self)
          </OnEnterPressed>
          <OnHyperlinkClick>
            SetItemRef(link, text, button, self);
          </OnHyperlinkClick>
        </Scripts>
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
            <Offset x="20" y="-32"/>
          </Anchor>
          <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT">
            <Offset x="-30" y="4"/>
          </Anchor>
        </Anchors>
        <FontString inherits="ChatFontNormal"/>
      </EditBox>

      <Button parentKey="SaveButton" name="$parentSaveButton">
        <Size x="18" y="18"/>

        <Scripts>
          <OnClick>
            OnSaveItem(self)
          </OnClick>
        </Scripts>

        <Anchors>
          <Anchor point="LEFT" relativeTo="$parentTodoText" relativePoint="RIGHT">
            <Offset x="6" y="-1"/>
          </Anchor>
        </Anchors>

        <NormalTexture file="Interface\Buttons\UI-PlusButton-Up"/>
        <PushedTexture file="Interface\Buttons\UI-PlusButton-Down"/>
        <HighlightTexture file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD"/>
      </Button>

      <Frame parentKey="Background" name="$parentBackground" inherits="BackdropTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentTodoText" relativePoint="BOTTOMLEFT">
            <Offset>
              <AbsDimension x="-6" y="-6"/>
            </Offset>
          </Anchor>
          <Anchor point="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="-30" y="12"/>
            </Offset>
          </Anchor>
        </Anchors>
        <KeyValues>
          <KeyValue key="backdropInfo" value="TodoChecklister_BACKDROP" type="global"/>
        </KeyValues>

        <Layers>
          <Layer level="OVERLAY">
            <FontString parentKey="BlankText" inherits="GameFontNormal">
              <Anchors>
                <Anchor point="CENTER" />
              </Anchors>
            </FontString>
          </Layer>
        </Layers>

        <Frames>
          <!-- Only the visible rows exist; ScrollBox reuses them while scrolling.
               A child of Background so its rows always draw above the translucent backdrop -->
          <Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
            <Anchors>
              <Anchor point="TOPLEFT" x="10" y="-6"/>
              <Anchor point="BOTTOMRIGHT" x="-2" y="6"/>
            </Anchors>
          </Frame>
        </Frames>
      </Frame>

      <EventFrame parentKey="ScrollBar" inherits="WowTrimScrollBar">
        <KeyValues>
          <KeyValue key="hideIfUnscrollable" value="true" type="boolean"/>
        </KeyValues>
        <Anchors>
          <Anchor point="TOPLEFT" relativeKey="$parent.Background" relativePoint="TOPRIGHT" x="1" y="0"/>
          <Anchor point="BOTTOMLEFT" relativeKey="$parent.Background" relativePoint="BOTTOMRIGHT" x="1" y="0"/>
        </Anchors>
      </EventFrame>
    </Frames>
  </Frame>
</Ui>
