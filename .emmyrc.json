{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "Lua5.1"
  },
  "workspace": {
    "library": [
      ".annotations/wow-api/Annotations/Core"
    ],
    "ignoreDir": [
      ".annotations/wow-api/.git",
      "node_modules",
      ".tools",
      "vendor"
    ],
    "ignoreGlobs": [
      "**/libs/**",
      "vendor/**"
    ]
  },
  "diagnostics": {
    "globals": [
      "TodoChecklisterDB",
      "TodoChecklisterSettingsDB",
      "TodoChecklisterMapIcon",
      "TodoChecklisterCharacterDB",
      "TodoChecklister",
      "TodoChecklister_BACKDROP",
      "SOUNDKIT",
      "SlashCmdList",
      "StaticPopupDialogs",
      "StaticPopup_Show",
      "DEFAULT_CHAT_FRAME",
      "ReloadUI",
      "GetMinimapShape",
      "FrameStackTooltip_Toggle",
      "CreateScrollBoxListLinearView",
      "CreateDataProvider",
      "ScrollUtil",
      "ScrollBoxConstants",
      "DragIntersectionArea",
      "StackSplitFrame",
      "ChatFrameUtil",
      "ChatEdit_InsertLink",
      "StaticPopup_StandardNonEmptyTextHandler",
      "StaticPopup_StandardEditBoxOnEscapePressed",
      "NameUtil",
      "UISpecialFrames",
      "TodoChecklister_OnFolderButtonClick",
      "TodoChecklister_ObjectiveTrackerClick",
      "ObjectiveTrackerFrame",
      "STANDARD_TEXT_FONT",
      "CampaignQuestObjectiveTracker",
      "QuestObjectiveTracker",
      "ObjectiveTrackerLineFont",
      "CreateFramePool",
      "OBJECTIVE_TRACKER_COLOR"
    ],
    "globalsRegex": [
      "^SLASH_",
      "^BINDING_"
    ],
    "disable": [
      "duplicate-type"
    ]
  }
}
